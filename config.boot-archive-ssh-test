interfaces {
    ethernet eth0 {
        hw-id "0c:3f:62:50:00:00"
    }
    ethernet eth1 {
        hw-id "0c:3f:62:50:00:01"
    }
    ethernet eth2 {
        address "dhcp"
        hw-id "0c:3f:62:50:00:02"
    }
    ethernet eth3 {
        address "dhcp"
        hw-id "0c:3f:62:50:00:03"
    }
    ethernet eth4 {
        hw-id "0c:3f:62:50:00:04"
    }
    ethernet eth5 {
        hw-id "0c:3f:62:50:00:05"
    }
    ethernet eth6 {
        hw-id "0c:3f:62:50:00:06"
    }
    ethernet eth7 {
        hw-id "0c:3f:62:50:00:07"
    }
    ethernet eth8 {
        hw-id "0c:3f:62:50:00:08"
    }
    ethernet eth9 {
        hw-id "0c:3f:62:50:00:09"
    }
    loopback lo {
    }
}
service {
    ntp {
        allow-client {
            address "127.0.0.0/8"
            address "169.254.0.0/16"
            address "10.0.0.0/8"
            address "172.16.0.0/12"
            address "192.168.0.0/16"
            address "::1/128"
            address "fe80::/10"
            address "fc00::/7"
        }
        server time1.vyos.net {
        }
        server time2.vyos.net {
        }
        server time3.vyos.net {
        }
    }
    ssh {
        disable-host-validation
    }
}
system {
    config-management {
        commit-archive {
            location github {
                git {
                    authentication {
                        username "git"
                    }
                    path "/natali-rs1985/vyos-config.git"
                    server "github.com"
                    transport "ssh"
                }
            }
            location local {
                git {
                    path "/home/vyos/configs.git"
                    transport "file"
                }
            }
            source-address "127.0.0.1"
        }
        commit-revisions "100"
    }
    console {
        device ttyS0 {
            speed "115200"
        }
    }
    host-name "archive-ssh-test"
    login {
        operator-group default {
            command-policy {
                allow "*"
            }
        }
        user vyos {
            authentication {
                encrypted-password "$6$QxPS.uk6mfo$9QBSo8u1FkH16gMyAVhus6fU3LOzvLR9Z9.82m3tiHFAxTtIkhaZSWssSgzt4v4dGAL8rhVQxTg0oAG9/q11h/"
                plaintext-password ""
            }
        }
    }
    name-server "8.8.8.8"
    option {
        kernel {
            cpu {
                isolate-cpus "2-3"
            }
            memory {
                hugepage-size 2M {
                    hugepage-count "1800"
                }
            }
        }
        reboot-on-upgrade-failure "5"
    }
    syslog {
        local {
            facility all {
                level "info"
            }
            facility local7 {
                level "debug"
            }
        }
    }
}


